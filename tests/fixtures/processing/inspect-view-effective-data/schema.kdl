// Option declarations, setting contributions with a bound layer, a
// source-import node, and the shipped layered resolver over two layers.
schema settings version="1" {
    types {
        object Option {
            field name String
        }
        object Setting {
            field target "ref<Option>"
            field value String
            field layer "optional<String>"
        }
    }
    node option role=declaration type=Option {
        field name arg=0
    }
    node setting role=contribution type=Setting {
        field target arg=0
        field value arg=1
        field layer property=layer
    }
    node use role=source-import {
        field path String arg=0
    }
    resolution resolver=layered {
        layers user base
    }
}
