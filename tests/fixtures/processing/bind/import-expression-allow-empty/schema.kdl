// A schema whose locations rule admits the star pattern and allows an
// empty match: a pattern import matching nothing streams its import item
// and no document.
schema found version="1" {
    types {
        object Part {
            field id String
        }
    }
    locations allow-empty=#true {
        patterns star=#true
    }
    node part role=record type=Part {
        field id arg=0
    }
    node use role=source-import {
        field path String arg=0
    }
    document {
        following part use
    }
}
