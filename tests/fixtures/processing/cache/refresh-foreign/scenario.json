{
  "binary": "kdlith",
  "description": "cache refresh refuses a state directory holding a foreign entry before reading anything: KDLITH-CAC001 names it, exit 1, and the stale owned entry and the foreign file are both left byte-identical with no new entry written",
  "args": [
    "cache", "refresh", "--state", "state",
    "--schema", "{fx-suite}/processing/bind/imports.kdl",
    "data.kdl", "other.kdl"
  ],
  "expect": {
    "exit": 1,
    "files": {
      "state/8f18af67b57d0ec0.kdlith-cache": "expected/8f18af67b57d0ec0.kdlith-cache",
      "state/notes.txt": "expected/notes.txt"
    },
    "absent": [
      "state/b992d53eac9e24d0.kdlith-cache",
      "state/bc62d7990e5d1186.kdlith-cache"
    ],
    "stdout-golden": "stdout.golden",
    "stderr-golden": "stderr.golden"
  }
}
