// The schema the format/ data scenarios share. Its layout rule sets the
// line limits for every document; shop and item ask for their
// properties and children in declared order, and pack, which declares a
// sequence, cannot have them moved. Prose and Command are text types:
// prose reads folded and is refilled, a command is never broken.
schema shop version="1" {
    layout width=80 content-width=64
    types {
        enum Size {
            member small
            member large
        }
        string Slug {
            format kebab-case
        }
        string Prose {
            layout prose
        }
        string Command {
            layout verbatim
        }
        object Shop {
            field name String
            field motto "optional<Prose>"
            field owner "optional<String>"
        }
        object Item {
            field name String
            field size Size
            field kind "optional<Slug>"
            field price U64
            field note "optional<Prose>"
            field tags "list<String>"
            field run "optional<Command>"
        }
        object Pack {
            field name String
            field label "optional<String>"
            field count "optional<U64>"
        }
    }
    node shop role=record type=Shop {
        layout order=declared
        field name arg=0
        field motto child=motto
        field owner child=owner
        children item
        children pack
    }
    node item role=record type=Item {
        parents shop
        layout order=declared
        field name arg=0
        field size property=size
        field kind property=kind
        field price property=price
        field note child=note
        field tags {
            from {
                children tag {
                    args
                }
            }
        }
        field run child=run
    }
    node pack role=record type=Pack {
        parents shop
        layout order=declared
        field name arg=0
        field label child=label
        field count child=count
        sequence {
            step count
            step label
        }
    }
}
