schema s version="1" {
    types {
        object Entry {
            field id String
            field name String
        }
    }
    node entry role=record type=Entry {
        field id {
            from {
                child meta {
                    argument 0
                }
            }
        }
        field name {
            from {
                child meta {
                    argument 0
                }
            }
        }
    }
}
