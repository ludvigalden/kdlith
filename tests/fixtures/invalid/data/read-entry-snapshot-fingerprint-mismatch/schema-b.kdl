// The schema the seeded state was refreshed under.
schema shelf version="2" {
    types {
        string Locale {
            format kebab-case
        }
        object Item {
            field id String
            field locale Locale
        }
    }
    context {
        slot locale Locale
    }
    node locale role=context-control {
        field value Locale arg=0
        effects target=following {
            set locale field=value
        }
    }
    node item role=record type=Item {
        field id arg=0
        field locale context=locale
    }
    document {
        following locale item
    }
}
