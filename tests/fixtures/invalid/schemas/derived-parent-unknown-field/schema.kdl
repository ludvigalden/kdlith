// A schema whose mapping declarations derive their id from position and
// whose pack declarations derive their code from the enclosing concept:
// the mapping's id is omitted in data and bound as "<source>.<ordinal>"
// (the ordinal per source within its concept), and the pack's code is
// omitted and bound from the enclosing concept's code. Explicit values
// win over both derivations.
schema derivedid version="0" {
    types {
        object Concept {
            field code String
        }
        object Mapping {
            field id String
            field code String
            field source String
            field target String
        }
        object Pack {
            field code String
            field note String
        }
    }
    node concept role=declaration type=Concept root=#true {
        field code arg=0
        identity {
            domain concepts
            compose qualified-name code
        }
        children mapping
        children pack
    }
    node mapping role=declaration type=Mapping parent=concept {
        field id arg=0 {
            from {
                ordinal key=source
            }
        }
        field code {
            from {
                parent nosuch
            }
        }
        field source property=source
        field target property=target
        identity {
            domain mappings
            compose qualified-name code id
        }
    }
    node pack role=declaration type=Pack parent=concept root=#true {
        field code arg=0 {
            from {
                parent nosuch
            }
        }
        field note property=note
        identity {
            domain packs
            compose qualified-name code
        }
    }
}
