{
  "binary": "kdlith",
  "description": "cache refresh over a state holding an entry from an older source revision and an owned entry of another format version replaces both: the current entries are written byte for byte and the two stale owned files are removed",
  "args": [
    "cache", "refresh", "--state", "state",
    "--schema", "{fx-suite}/processing/bind/imports.kdl",
    "data.kdl", "other.kdl"
  ],
  "expect": {
    "exit": 0,
    "files": {
      "state/6a04fc03b2b2d0f9.kdlith-cache": "expected/6a04fc03b2b2d0f9.kdlith-cache",
      "state/7d32de8aad864ffd.kdlith-cache": "expected/7d32de8aad864ffd.kdlith-cache"
    },
    "absent": [
      "state/0000000000000000.kdlith-cache",
      "state/9514bd3d452d3f8f.kdlith-cache"
    ],
    "stdout-golden": "stdout.golden",
    "stderr-golden": "stderr.golden"
  }
}
