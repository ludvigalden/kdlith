{
  "binary": "kdlith",
  "description": "Import confinement judges the resolved path, not its spelling: sub/../b.kdl carries a .. segment yet resolves inside the entry document's directory, so it is followed like the plain sub/a.kdl import before it",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/bind/imports.kdl",
    "data.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"document\",\"data\":{\"source\":1,\"path\":\"sub/a.kdl\"}}\n",
      "\"expression\":\"sub/../b.kdl\",\"targets\":[\"sub/../b.kdl\"],",
      "{\"item\":\"document\",\"data\":{\"source\":2,\"path\":\"sub/../b.kdl\"}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":2,\"index\":0},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"b\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n"
    ],
    "stdout-not-contains": ["\"item\":\"diagnostic\""]
  }
}
