// A value a context slot or a literal fallback feeds a field decodes
// against the field's own type, as an explicit supply does: the
// String-typed `shelf` slot feeds a ShelfRef field a reference decoded
// through its codec, a `list<ShelfRef>` field fed one value holds it as
// its one element, and a contextual reference type qualifies a fed
// bare spelling from the context in effect at the bound node.
schema shelf version="1" {
    types {
        codec ShelfName output=String {
            match #"(?<name>[a-z]+)"#
            capture name String
        }
        codec Placed output=String {
            match #"(?:(?<room>[a-z]+):)?(?<name>[a-z]+)"#
            capture room String
            capture name String
        }
        object Room {
            field id String
        }
        object Shelf {
            field id String
        }
        object Spot {
            field room String
            field id String
        }
        object Book {
            field title String
            field shelf "optional<ShelfRef>"
            field tags "list<ShelfRef>"
            field placed "optional<PlacedRef>"
            field kind "optional<ShelfRef>"
        }
        object Defaults {
            field shelf "optional<String>"
        }
    }
    reference ShelfRef target=Shelf codec=ShelfName lookup=shelves qualification=explicit
    reference PlacedRef target=Spot codec=Placed lookup=placed qualification=explicit-or-context {
        qualifier room String required=#false
    }
    context {
        slot namespace String duplicates=reject
        slot shelf String duplicates=last-wins
    }
    node room root=#true role=context-control type=Room {
        field id arg=0
        effects target=following {
            set namespace field=id
        }
    }
    node shelf root=#true role=declaration type=Shelf {
        identity {
            domain shelves
            compose qualified-name id
        }
        field id arg=0
    }
    node spot root=#true role=declaration type=Spot {
        identity {
            domain placed
            compose qualified-name room id
        }
        field id arg=0
        field room {
            from {
                context namespace policy=fallback
            }
        }
    }
    node defaults root=#true role=context-control type=Defaults {
        field shelf property=shelf
        effects target=following {
            set shelf field=shelf
        }
    }
    node book root=#true role=record type=Book {
        field title arg=0
        field shelf {
            from {
                property shelf
                context shelf policy=fallback
            }
        }
        field tags {
            from {
                property tag
                context shelf policy=fallback
            }
        }
        field placed {
            from {
                property placed
                context shelf policy=fallback
            }
        }
        field kind property=kind
    }
}
