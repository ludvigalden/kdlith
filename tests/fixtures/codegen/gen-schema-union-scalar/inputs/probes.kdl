schema probes version="1" {
    types {
        union NumOrTemplate {
            variant number U64
            variant template String prefix="${"
        }
        union NumOrText {
            variant number U64
            variant text String
        }
        union TextOrTemplate {
            variant text String
            variant template String prefix="${"
        }
    }
    node probe role=record {
        field v NumOrTemplate arg=0
    }
    node label role=record {
        field v NumOrText arg=0
    }
    node slot role=record {
        field v TextOrTemplate arg=0
    }
}
