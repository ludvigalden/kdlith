// A context control naming the built-in copy-fields handler while its
// field is named zone: the handler sets a slot per field name, and
// the schema declares only the locale slot, so the handler's effect
// addresses a slot the definition does not declare.
schema handlers version="1" {
    types {
        string Locale {
            format kebab-case
        }
    }
    context {
        slot locale Locale namespace=defaults
    }
    node locale role=context-control {
        field zone Locale arg=0
        effects target=following {
            handler copy-fields
        }
    }
}
