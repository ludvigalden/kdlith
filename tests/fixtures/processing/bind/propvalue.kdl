// The schema the from-type-name scenarios share: property definitions
// declare, in their value-type string, the type name their values bind
// under, and property records name a definition and carry the value;
// each payload is typed by the declared type the referenced definition
// names, so the same node shape binds every value by the definition it
// names. The entry node spells the same binding through a property
// reference beside a plain identity, for reading a record by name.
schema propvalue version="1" {
    types {
        object PropertyDef {
            field name String
            field value-type String
        }
        union Flex {
            variant number U64
            variant template String prefix="${"
        }
        codec PropName output=String {
            match #"(?<name>[a-z0-9-]+)"#
            capture name String
        }
    }
    node property-def role=declaration type=PropertyDef {
        field name arg=0
        field value-type property=value-type
    }
    node property role=record {
        field target "ref<PropertyDef>" arg=0
        value codec=from-type-name {
            against target=target member=value-type
        }
    }
    node entry role=record {
        field id String arg=0
        field target "ref<PropertyDef>" property=of
        value codec=from-type-name {
            against target=target member=value-type
        }
        identity {
            domain entries
            compose qualified-name id
        }
    }
    reference PropRef target=PropertyDef codec=PropName lookup=properties qualification=explicit
}
