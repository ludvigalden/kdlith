schema s version="1" {
    types {
        object Entry {
            field id String
            field name String
        }
    }
    node entry role=record type=Entry parent=box {
        field id arg=0
    }
    node other role=record type=Entry {
        field id arg=0
    }
    node box role=container {
        children entry
        exactly-one entry other
    }
}
