{
  "binary": "kdlith",
  "description": "A --profiles list with an empty name (here a trailing comma) is rejected by the argument parser: exit 2 under KDLITH-CLI001",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/bind/profiles.kdl",
    "--profiles",
    "base,",
    "plain.kdl"
  ],
  "expect": {
    "exit": 2,
    "stderr-contains": [
      "error[KDLITH-CLI001]"
    ],
    "stdout-golden": "stdout.golden",
    "stderr-golden": "stderr.golden"
  }
}
