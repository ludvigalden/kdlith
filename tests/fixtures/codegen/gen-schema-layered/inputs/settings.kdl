// A self-contained schema naming the shipped `layered` resolver: option
// and scope declarations are the targets setting contributions name,
// each setting binds its layer from the `layer` property and its
// application scope from the `scope` property, the notes list declares
// merge=union so refinements append under the policy's selection=union,
// and the policy ranks user over base. Setting tags nest an ordered map
// inside an optional, and the typeless metadata record holds an ordered
// map in a node-local field, so the generated crate must import the map
// type for both. Option names are a declared string type, so the
// generated newtype keys a map, formats, and names its declaration.
schema settings version="1" {
    types {
        string OptionName {
            format kebab-case
        }
        object ScopeDef {
            field name String
        }
        object Choice {
            field name OptionName
        }
        object Tag {
            field text String
        }
        object Note {
            field text String
        }
        object Setting {
            field scope "optional<ScopeTerm>"
            field target "ref<Choice>"
            field value String
            field follows "optional<ref<Choice>>"
            field layer "optional<String>"
            field tags "optional<ordered-map<String, Tag>>"
            field notes "optional<list<Note>>" merge=union
        }
        codec ScopeSpelling output=String {
            match #"(?<name>[a-z][a-z0-9-]*)"#
            capture name String
        }
        union Patch {
            variant replace String
            variant append String
        }
    }
    node scope role=declaration type=ScopeDef {
        field name arg=0
    }
    node option role=declaration type=Choice {
        field name arg=0
    }
    reference ScopeTerm target=ScopeDef codec=ScopeSpelling qualification=explicit
    node setting role=contribution type=Setting {
        field scope property=scope
        field target arg=0
        field value arg=1
        field follows property=follows
        field layer property=layer
        field tags {
            from {
                entries tag key="arg(0)" value=Tag
            }
            duplicate-keys reject
        }
        field notes {
            from {
                children note
            }
        }
    }
    node tag type=Tag parent=setting {
        field text arg=1
    }
    node note type=Note parent=setting {
        field text arg=0
    }
    node metadata role=record {
        field pairs "ordered-map<String, Tag>" {
            from {
                entries pair key="arg(0)" value=Tag
            }
            duplicate-keys reject
        }
    }
    node pair type=Tag parent=metadata {
        field text arg=1
    }
    resolution resolver=layered selection=union {
        layers user base
    }
}
