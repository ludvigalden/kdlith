// The schema the list scenarios share. Every collection is declared out
// of name order, so a sorted listing proves the order is chosen rather
// than inherited from declaration order: types of several declaration
// kinds, root nodes of four roles plus a record admitted under two
// parents, and two profiles (one declaring a locations rule and root
// types, one admitting every root and selected by default). It is also
// the entrypoint codegen/gen-schema-node-keyed generates from: three
// differently named nodes bind Widget, so each reads as its own item
// variant, which is why it declares only kinds a generated crate spells.
schema shop version="1" {
    types {
        object Widget {
            field id String
            field tone Tone
        }
        enum Tone {
            member warm
            member cool
        }
        string Slug {
            format kebab-case
        }
        object Bin {
            field name String
        }
    }
    node widget role=record type=Widget {
        field id arg=0
        field tone property=tone
        children part
    }
    node bin role=declaration type=Bin {
        field name arg=0
        children part
    }
    node gadget role=record type=Widget {
        field id arg=0
        field tone property=tone
    }
    node part role=record type=Widget {
        parents widget bin
        field id arg=0
        field tone property=tone
    }
    node use role=source-import {
        field path String arg=0
    }
    profile wholesale {
        locations {
            patterns star=#true
        }
        roots {
            allow Widget
            allow Bin
        }
    }
    profile retail default=#true
}
