// A self-contained schema whose contribution payload binds under
// from-kind, so each payload stays pending until a linked reading
// selects its shape from the kind the referenced setting holds.
schema settings version="1" {
    types {
        object Setting {
            field name String
            field kind "optional<String>"
            field choices "optional<list<String>>"
        }
        codec SettingName output=String {
            match #"(?<name>[a-z0-9-]+)"#
            capture name String
        }
    }
    node setting role=declaration type=Setting {
        field name arg=0
        field kind property=kind
        field choices {
            from {
                args
            }
        }
    }
    node put role=contribution {
        field target "ref<Setting>" arg=0
        value codec=from-kind {
            against target=target member=kind
        }
    }
    reference SettingRef target=Setting codec=SettingName qualification=explicit
}
