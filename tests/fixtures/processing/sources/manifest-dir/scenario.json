{
  "binary": "kdlith",
  "description": "A sources manifest declares a dir source: source acme dir=vendor/acme, relative to the manifest, backs $acme/ in map/entry.kdl. A dir source takes no pin, so the reading notes nothing about it (no KDLITH-LOC010) and exits 0",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/sources/schema.kdl",
    "--sources",
    "sources.kdl",
    "map/entry.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":1,\"index\":0},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"vendored\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n",
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":1},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"local\"},\"origin\":1}],\"origin\":1,\"validation\":\"valid\"}}\n"
    ],
    "stdout-not-contains": [
      "KDLITH-LOC010"
    ]
  }
}
