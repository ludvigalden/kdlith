schema cards version="1" {
    types {
        object Card { field label String }
        object Deck {
            field name String
            field cards "list<Card>"
        }
    }
    group parts card badge
    node deck role=record type=Deck {
        field name arg=0
        field cards {
            from {
                children card
                children badge
            }
        }
    }
    node card type=Card parent=deck {
        field label arg=0
    }
    node badge type=Card parent=deck {
        field label arg=0
    }
}
