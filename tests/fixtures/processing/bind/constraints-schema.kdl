// The schema the object-constraint and case-required scenarios share:
// a record whose type states requires and all-or-none over two nullable
// fields, a record whose collected list is supplied even when empty, a
// record whose case dispatch selects a type with a required field, a
// record whose type bounds a U64, an Integer, a Decimal, and a list, and
// records whose exclusivity lists name fields bound from an argument, a
// property, and a child, a union field, an included field, and fields
// filled by a literal fallback and by a resolved computed default.
schema constraints version="1" {
    types {
        object Item {
            field a "optional<nullable<String>>"
            field b "optional<nullable<String>>"
            constraints {
                requires a b
                all-or-none a b
            }
        }
        object Tagged {
            field tags "list<String>"
            field note "optional<String>"
            constraints {
                requires tags note
            }
        }
        object Limited {
            field wait "optional<U64>"
            field offset "optional<Integer>"
            field ratio "optional<Decimal>"
            field steps "list<U64>"
            constraints {
                bound wait min=10 max=5000
                bound offset min=0 max=100
                bound ratio max=1
                bound steps max=9
            }
        }
        object Shape {
            field shape String
            field radius "optional<U64>"
            field side "optional<U64>"
        }
        object Circle {
            field shape String
            field radius U64
        }
        object Square {
            field shape String
            field side U64
        }
        object Locator {
            field url "optional<String>"
        }
        object Capture {
            field name "optional<String>"
            field file "optional<nullable<String>>"
            field selector "optional<String>"
            constraints {
                at-most-one name file selector
            }
        }
        object Target {
            include Locator
            field text "optional<String>"
            field pick "optional<union<U64, String>>"
            constraints {
                exactly-one-field url text pick
            }
        }
        object Pause {
            field wait "optional<U64>" {
                fallback 100
            }
            field delay "optional<U64>"
            field token "optional<String>" {
                fallback computed=#true {
                    dependency "token"
                }
            }
            field secret "optional<String>"
            constraints {
                exactly-one-field wait delay
                exactly-one-field token secret
            }
        }
    }
    node item role=record type=Item {
        field a property=a
        field b property=b
    }
    node tagged role=record type=Tagged {
        field tags {
            from {
                children tag {
                    argument 0
                }
            }
        }
        field note property=note
    }
    node limited role=record type=Limited {
        field wait property=wait
        field offset property=offset
        field ratio property=ratio
        field steps {
            from {
                children step {
                    argument 0
                }
            }
        }
    }
    node g role=record type=Shape {
        field shape property=shape
        field radius property=radius
        field side property=side
        cases {
            case property=shape equals=circle type=Circle
            case property=shape equals=square type=Square
        }
    }
    node capture role=record type=Capture {
        field name arg=0
        field file property=file
        field selector child=selector
    }
    node target role=record type=Target {
        field url property=url
        field text arg=0
        field pick property=pick
    }
    node pause role=record type=Pause {
        field wait property=wait
        field delay property=delay
        field token property=token
        field secret property=secret
    }
}
