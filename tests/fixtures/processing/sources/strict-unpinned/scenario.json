{
  "binary": "kdlith",
  "description": "--warnings-as-errors with a dir source exits 0 and notes nothing: a dir source takes no pin, so it is never KDLITH-LOC010, under a strict CI gate either",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/sources/schema.kdl",
    "--sources",
    "sources.kdl",
    "--warnings-as-errors",
    "map/entry.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":1,\"index\":0},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"vendored\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n"
    ],
    "stdout-not-contains": [
      "KDLITH-LOC010"
    ]
  }
}
