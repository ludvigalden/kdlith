// The literal twin of schemas/vet/import-source-pattern: the same
// declarations and locations rule, with byte-identical copies of the two
// contributing documents imported by literal location in the order the
// pattern's portable-path-byte ordering yields.
schema demo version="1" {
    types {
        object Thing {
            field name String
        }
    }
    node thing role=record type=Thing {
        field name arg=0
    }
    locations {
        patterns star=#true
    }
    import "parts/a.kdl"
    import "parts/b.kdl"
    document {
        first {
            exactly-one thing
        }
        following extra
    }
}
