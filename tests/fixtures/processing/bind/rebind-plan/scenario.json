{
  "binary": "kdlith",
  "description": "The plan view spells a replace group's set step with replace=true — the only set step carrying the flag; every other control's set renders without it, so a replace group is visible in the compiled plan of the reading",
  "args": [
    "inspect",
    "data",
    "--view",
    "plan",
    "--schema",
    "{fx-suite}/processing/bind/rebind.kdl",
    "data.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"plan-node\",\"data\":{\"name\":\"rebind\",\"role\":\"context-control\",\"scope\":2,\"children-effects\":[],\"following-effects\":[{\"effect\":\"set\",\"slot\":\"release\",\"field\":\"release\",\"layer\":null,\"replace\":true}],\"context-reads\":[],\"deferred\":[],\"dependent\":null,\"value-from-path\":null,\"declaration\":false,\"requires\":[\"global-validation\"]}}\n",
      "{\"item\":\"plan-node\",\"data\":{\"name\":\"release\",\"role\":\"context-control\",\"scope\":1,\"children-effects\":[],\"following-effects\":[{\"effect\":\"set\",\"slot\":\"release\",\"field\":\"value\",\"layer\":null}],\"context-reads\":[],\"deferred\":[],\"dependent\":null,\"value-from-path\":null,\"declaration\":false,\"requires\":[\"global-validation\"]}}\n"
    ]
  }
}
