repo kdlith {
    // The harness reads the fixture corpus.
    input fixtures kind=data {
        path "tests/fixtures"
        consumers "tests/tools/kdlith-fixtures"
    }
    // The schema-kdl crate's build script embeds these documents, and its
    // generated code must equal what generating the meta-schema makes of
    // them; fixture scenarios read them.
    input meta-schema kind=data {
        path "pkg/kdl/schemas/schema"
        consumers "pkg/rs/schema-kdl" "tests/tools/kdlith-fixtures"
    }
    // The sources-manifest schema; fixture scenarios vet against it.
    input sources-schema kind=data {
        path "pkg/kdl/schemas/sources"
        consumers "tests/tools/kdlith-fixtures"
    }
}
