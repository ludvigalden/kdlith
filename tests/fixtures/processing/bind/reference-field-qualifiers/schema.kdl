schema tools version="1" {
    types {
        object ToolDef {
            field name String
        }
        object Run {
            field tool ToolRef
        }
        codec ToolRef output=String {
            match #"(?<contract>[a-z0-9]+):(?<program>[a-z]+)/(?<tool>[a-z-]+)"#
            capture contract String
            capture program String
            capture tool String
        }
    }
    node run role=record type=Run {
        field tool arg=0
    }
    reference ToolRef target=ToolDef codec=ToolRef qualification=explicit {
        qualifier contract String
    }
}
