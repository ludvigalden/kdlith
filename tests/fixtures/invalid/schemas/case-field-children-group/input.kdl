schema s version="1" {
    types {
        object Shape { field label String }
        object Selector {
            field name String
            field kind String
            field carries "list<Shape>"
        }
    }
    group options alpha beta
    node selector role=record type=Selector {
        field name arg=0
        field kind property=kind
        cases {
            case property=kind equals="rich" type=Selector {
                field carries {
                    from {
                        children-group options
                    }
                }
            }
            otherwise type=Selector
        }
    }
    node alpha type=Shape parent=selector {
        field label arg=0
    }
    node beta type=Shape parent=selector {
        field label arg=0
    }
}
