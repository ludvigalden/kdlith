{
  "binary": "kdlith",
  "description": "A handler-set slot projected into instantiated imports: every import of the same source is its own invocation under the caller's projected context at that point — sources 1 and 2 read en-gb set by the caller's copy-fields handler, source 3 reads fr-fr after the caller's handler sets it again — and each imported document's own handler setting sv-se stays inside its invocation, so the caller's closing stamp reads fr-fr",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/bind/imports-handler.kdl",
    "--handler",
    "copy-fields",
    "data.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"import\",\"data\":{\"node\":{\"source\":0,\"index\":1},\"expression\":\"part.kdl\",\"targets\":[\"part.kdl\"],\"namespace\":null,\"project\":[\"locale\"],\"repeated\":\"instantiate\",\"site\":{\"source\":0,\"span\":{\"start\":{\"offset\":13,\"line\":2,\"column\":1},\"end\":{\"offset\":16,\"line\":2,\"column\":4}}},\"origin\":1}}\n{\"item\":\"document\",\"data\":{\"source\":1,\"path\":\"part.kdl\"}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":1,\"index\":0},\"type_name\":\"Stamp\",\"fields\":[{\"name\":\"at\",\"value\":{\"kind\":\"string\",\"value\":\"en-gb\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n",
      "{\"item\":\"import\",\"data\":{\"node\":{\"source\":0,\"index\":3},\"expression\":\"./part.kdl\",\"targets\":[\"part.kdl\"],\"namespace\":null,\"project\":[\"locale\"],\"repeated\":\"instantiate\",\"site\":{\"source\":0,\"span\":{\"start\":{\"offset\":72,\"line\":5,\"column\":1},\"end\":{\"offset\":75,\"line\":5,\"column\":4}}},\"origin\":3}}\n{\"item\":\"document\",\"data\":{\"source\":2,\"path\":\"part.kdl\"}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":2,\"index\":0},\"type_name\":\"Stamp\",\"fields\":[{\"name\":\"at\",\"value\":{\"kind\":\"string\",\"value\":\"en-gb\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n",
      "{\"item\":\"document\",\"data\":{\"source\":3,\"path\":\"part.kdl\"}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":3,\"index\":0},\"type_name\":\"Stamp\",\"fields\":[{\"name\":\"at\",\"value\":{\"kind\":\"string\",\"value\":\"fr-fr\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":3,\"index\":2},\"type_name\":\"Stamp\",\"fields\":[{\"name\":\"at\",\"value\":{\"kind\":\"string\",\"value\":\"sv-se\"},\"origin\":2}],\"origin\":2,\"validation\":\"valid\"}}\n",
      "{\"item\":\"scope-complete\",\"data\":{\"source\":0,\"scope\":null}}\n"
    ]
  }
}
