{
  "binary": "kdlith",
  "description": "read data --scope complete consults the scope-less partition too: font, contributed with no scope, resolves there to sans under the user-over-base layer order",
  "args": [
    "read",
    "data",
    "--scope",
    "complete",
    "--schema",
    "{fx-suite}/processing/resolution/scope.kdl",
    "{fx-suite}/processing/resolution/scope-partition/data.kdl",
    "font"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "\"item\":\"resolution\"",
      "\"written\":\"font\"",
      "sans",
      "\"layers\":[\"user\"]",
      "\"scope\":null"
    ]
  }
}
