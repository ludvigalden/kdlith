// A schema whose controls name the built-in copy-fields and
// clear-namespace handlers: clear-namespace clears the namespace the
// reset control's string field names, unsetting every slot in it, so
// later sets on those slots are first ones.
schema handlers version="1" {
    types {
        string Locale {
            format kebab-case
        }
        object Stamp {
            field at "optional<Locale>"
            field near "optional<Locale>"
        }
    }
    context {
        slot locale Locale namespace=defaults
        slot region Locale namespace=defaults
    }
    node locale role=context-control {
        field locale Locale arg=0
        field region "optional<Locale>" arg=1
        effects target=following {
            handler copy-fields
        }
    }
    node reset role=context-control {
        field namespace String arg=0
        effects target=following {
            handler clear-namespace
        }
    }
    node stamp role=record type=Stamp {
        field at context=locale
        field near context=region
    }
}
