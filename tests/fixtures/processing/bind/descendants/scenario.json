{
  "binary": "kdlith",
  "description": "A descendant rule bounds occurrences of a node anywhere in the declaring node's subtree, checked when the declaring scope completes: the nested thing satisfies max-occurs=1 declared two levels above it",
  "args": [
    "vet",
    "data",
    "--schema",
    "schema.kdl",
    "data.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":2},\"type_name\":\"Thing\",\"fields\":[{\"name\":\"name\",\"value\":{\"kind\":\"string\",\"value\":\"t\"},\"origin\":2}],\"origin\":2,\"validation\":\"valid\"}}\n",
      "{\"item\":\"scope-complete\",\"data\":{\"source\":0,\"scope\":{\"source\":0,\"index\":0}}}\n{\"item\":\"scope-complete\",\"data\":{\"source\":0,\"scope\":null}}\n"
    ]
  }
}
