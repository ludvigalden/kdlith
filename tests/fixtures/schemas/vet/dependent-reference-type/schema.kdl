schema pending version="1" {
    types {
        object Setting {
            field name String
            field text String
        }
        codec SettingName output=String {
            match #"(?<name>[a-z0-9-]+)"#
            capture name String
        }
    }
    node setting role=declaration type=Setting {
        field name arg=0
        field text property=text
    }
    node put-text role=contribution {
        field target SettingRef arg=0
        value codec=fixture-value {
            against target=target member=text
        }
    }
    reference SettingRef target=Setting codec=SettingName qualification=explicit
}
