{
  "binary": "kdlith",
  "description": "An alias-addressed import carrying as=base keeps its namespace alias in the executed request: the import item names base while the target shows the import-alias spelling",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/bind/imports.kdl",
    "--alias",
    "shared=lib",
    "map/entry.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"import\",\"data\":{\"node\":{\"source\":0,\"index\":0},\"expression\":\"$shared/part.kdl\",\"targets\":[\"$shared/part.kdl\"],\"alias\":\"base\",\"project\":[],\"repeated\":\"reject\"",
      "{\"item\":\"document\",\"data\":{\"source\":1,\"path\":\"$shared/part.kdl\"}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":1,\"index\":0},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"shared\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n"
    ],
    "stdout-not-contains": [
      "\"item\":\"diagnostic\""
    ]
  }
}
