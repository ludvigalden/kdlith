// A schema whose own import is a pattern in a named source: the root's
// locations rule admits the star pattern, and nothing matches it.
schema demo version="1" {
    types {
        object Thing {
            field name String
        }
    }
    node thing role=record type=Thing {
        field name arg=0
    }
    locations {
        patterns star=#true
    }
    import "$parts/none-*.kdl"
    document {
        first {
            exactly-one thing
        }
        following extra
    }
}
