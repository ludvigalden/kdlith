{
  "binary": "kdlith",
  "description": "--override NAME=DIR is the command-line layer: KDLITH-LOC009 names layer cli and the directory as written, and the override's tree is read",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/sources/schema.kdl",
    "--sources",
    "sources.kdl",
    "--override",
    "acme=local/acme",
    "map/entry.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":1,\"index\":0},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"cli-override\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n",
      "\"facts\":{\"declared\":\"unpinned\",\"directory\":\"local/acme\",\"layer\":\"cli\",\"shadowed\":[],\"source\":\"acme\"}"
    ],
    "stderr-contains": [
      "warning[KDLITH-LOC009]: source acme is overridden by local/acme (layer cli; unpinned not used)"
    ]
  }
}
