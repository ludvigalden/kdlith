{
  "binary": "kdlith",
  "description": "read data --meta-schema: the meta-schema-generation entrypoint governs the schema load; the same record line processing/read-data-found prints under the bundled meta-schema is printed",
  "args": [
    "read",
    "data",
    "--meta-schema",
    "{fx-suite}/../../pkg/kdl/schemas/schema/schema.kdl",
    "--schema",
    "{fx-suite}/processing/bind/schema.kdl",
    "{fx-suite}/processing/bind/stream/input.kdl",
    "one"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":6},\"type_name\":\"Item\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"one\"}"
    ]
  }
}
