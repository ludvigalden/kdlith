schema catalog version="1" {
    import "parts.kdl"
    types {
        string Locale {
            format kebab-case
        }
        object Entry {
            field id String
            field locale "optional<Locale>"
            field group "optional<GroupRef>"
        }
        object Group {
            field name String
        }
        codec GroupName output=String {
            match #"(?<name>[a-z0-9-]+)"#
            capture name String
        }
    }
    context {
        slot locale Locale namespace=defaults
    }
    node group role=declaration type=Group {
        field name arg=0
    }
    node entry role=record type=Entry {
        parents locale
        field id arg=0
        field locale {
            from {
                property locale
                context locale policy=fallback
            }
        }
        field group property=group
    }
    node locale role=context-control {
        field value Locale arg=0
        effects target=following {
            set locale field=value
        }
        effects target=children {
            set locale field=value
        }
        children entry
    }
    node defaults-reset role=context-control {
        effects target=following {
            clear defaults
        }
    }
    document {
        first {
            exactly-one locale group
        }
        following group locale defaults-reset
    }
    reference GroupRef target=Group codec=GroupName qualification=explicit
}
