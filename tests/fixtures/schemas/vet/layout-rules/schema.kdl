// The schema the format/ data scenarios share. Its layout rule sets the
// line limits for every document; order is declared by default, so shop
// and item write their properties and children in field order, while
// bundle opts out with order=authored and pack, which declares a
// sequence, cannot have its children moved. A banner is admitted by a
// children rule alone, so it stays where it is written. Prose and
// Command are text types: prose reads folded and is refilled, a command
// is never broken.
schema shop version="1" {
    layout width=80 content-width=64
    types {
        enum Size {
            member small
            member large
        }
        string Slug {
            format kebab-case
        }
        string Prose {
            layout prose
        }
        string Command {
            layout verbatim
        }
        object Shop {
            field name String
            field motto "optional<Prose>"
            field owner "optional<String>"
        }
        object Item {
            field name String
            field size Size
            field kind "optional<Slug>"
            field price U64
            field note "optional<Prose>"
            field tags "list<String>"
            field run "optional<Command>"
        }
        object Banner {
            field text String
        }
        object Bundle {
            field name String
            field label "optional<String>"
            field count "optional<U64>"
        }
        object Pack {
            field name String
            field label "optional<String>"
            field count "optional<U64>"
        }
    }
    node shop role=record type=Shop {
        field name arg=0
        field motto child=motto
        field owner child=owner
        children banner
        children item
        children pack
        children bundle
    }
    node banner type=Banner parent=shop {
        field text arg=0
    }
    node item role=record type=Item {
        parents shop
        field name arg=0
        field size property=size
        field kind property=kind
        field price property=price
        field note child=note
        field tags {
            from {
                children tag {
                    args
                }
            }
        }
        field run child=run
    }
    node bundle role=record type=Bundle {
        parents shop
        layout order=authored
        field name arg=0
        field label child=label
        field count child=count
    }
    node pack role=record type=Pack {
        parents shop
        field name arg=0
        field label child=label
        field count child=count
        sequence {
            step count
            step label
        }
    }
}
