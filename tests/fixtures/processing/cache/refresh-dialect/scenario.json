{
  "binary": "kdlith",
  "description": "cache refresh --dialect: the dialect-generation entrypoint governs the schema load; the written entries (identity metadata included), stdout, and stderr are byte-identical to processing/cache/refresh under the bundled dialect (the goldens are that scenario's, unchanged)",
  "args": [
    "cache",
    "refresh",
    "--dialect",
    "{fx-suite}/../../contracts/super-schemas/dialect.kdl",
    "--state",
    "state",
    "--schema",
    "{fx-suite}/processing/bind/imports.kdl",
    "data.kdl",
    "other.kdl"
  ],
  "expect": {
    "exit": 0,
    "files": {
      "state/b992d53eac9e24d0.kdlith-cache": "expected/b992d53eac9e24d0.kdlith-cache",
      "state/bc62d7990e5d1186.kdlith-cache": "expected/bc62d7990e5d1186.kdlith-cache"
    },
    "absent": [
      "state/.b992d53eac9e24d0.kdlith-cache-part",
      "state/.bc62d7990e5d1186.kdlith-cache-part"
    ],
    "stdout-golden": "stdout.golden",
    "stderr-golden": "stderr.golden"
  }
}
