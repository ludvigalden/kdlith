{
  "binary": "kdlith",
  "description": "With no listed profile's rules matching and no listed default, the first listed profile is active: plain.kdl under --profiles outlet,base selects outlet, so its Gadget root binds",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/bind/profiles.kdl",
    "--profiles",
    "outlet,base",
    "plain.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":0},\"type_name\":\"Gadget\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"d1\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n"
    ]
  }
}
