// The literal twin of schemas/vet/import-anchor: the same declarations,
// with byte-identical copies of the two contributing documents imported
// by literal path in the order the expression's portable-path-byte
// ordering yields.
schema demo version="1" grammar=main {
    types {
        object Thing {
            field name String
        }
    }
    node thing role=record type=Thing {
        field name arg=0
    }
    discovery main {
        anchor root provider=path
        patterns star=#true
    }
    import "parts/a.kdl"
    import "parts/b.kdl"
    document {
        first {
            exactly-one thing
        }
        following extra
    }
}
