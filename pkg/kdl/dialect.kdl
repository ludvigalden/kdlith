// kdlith dialect-generation entrypoint: the full dialect.
//
// This document selects the canonical dialect definition documents under
// pkg/kdl/schemas/dialect/ through source imports. It declares nothing of
// its own: the canonical documents are the only authority for the dialect,
// and this entrypoint is the input dialect generation reads, so generation
// always reads exactly what is committed there.
//
// Import paths are literal and resolved relative to this document. Each
// canonical document contributes to the same dialect root (same name and
// version), and imports are processed in the order written. No context is
// projected: the dialect declares no context slots of its own.

dialect kdlith version="0" {
    import "schemas/dialect/types.kdl"
    import "schemas/dialect/bindings.kdl"
    import "schemas/dialect/context.kdl"
    import "schemas/dialect/documents.kdl"
}
