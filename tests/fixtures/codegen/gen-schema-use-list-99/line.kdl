schema widths version="1" {
    types {
        object Line {
            field id String
            field f0 "optional<LineAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>"
            field f1 "optional<LineBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>"
        }
    }
    node line role=record type=Line {
        field id arg=0
    }
}
