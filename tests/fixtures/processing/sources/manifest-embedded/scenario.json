{
  "binary": "kdlith",
  "description": "A host-registered source and a manifest coexist when the manifest does not redeclare the host's name: acme comes from the host (a --source directory, then embedded through the pair helper, byte-identical), extra from the manifest. Neither is noted: a host's source never is, and extra is a dir source, which takes no pin",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/sources/schema.kdl",
    "--sources",
    "sources.kdl",
    "map/entry.kdl"
  ],
  "source-embedded": [
    "acme=lib"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":1,\"index\":0},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"embedded\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n",
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":2,\"index\":0},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"extra\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n",
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":2},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"local\"},\"origin\":2}],\"origin\":2,\"validation\":\"valid\"}}\n"
    ],
    "stdout-not-contains": [
      "KDLITH-LOC010"
    ]
  }
}
