// A schema declaring profiles binds its discovery grammar per invocation
// profile, and loading the schema names none, so its own import
// expression is evaluated with no grammar bound even though the host
// supplies the anchor the profile's grammar declares.
schema demo version="1" {
    types {
        object Thing {
            field name String
        }
    }
    node thing role=record type=Thing {
        field name arg=0
    }
    discovery main {
        anchor root provider=path
        patterns star=#true
    }
    profile only grammar=main
    import "$root/*.kdl"
}
