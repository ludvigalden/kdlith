    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":5},\"type_name\":\"Seen\",\"fields\":[{\"name\":\"kept\",\"value\":{\"kind\":\"map\",\"value\":[{\"key\":\"a\",\"value\":{\"kind\":\"map\",\"value\":[{\"key\":\"text\",\"value\":{\"kind\":\"string\",\"value\":\"again\"}}]}},{\"key\":\"b\",\"value\":{\"kind\":\"map\",\"value\":[{\"key\":\"text\",\"value\":{\"kind\":\"string\",\"value\":\"two\"}}]}}]},\"origin\":5}],\"origin\":5,\"validation\":\"valid\"}}\n{\"item\":\"scope-complete\",\"data\":{\"source\":0,\"scope\":null}}\n"
    ]
  }
}
