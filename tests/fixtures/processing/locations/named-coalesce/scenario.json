{
  "binary": "kdlith",
  "description": "Two $name/ imports of one document under repeated=coalesce reuse the first invocation: $shared/./part.kdl normalizes to the same target, so the document is read once (one document item, under source 1) and the run stays green",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/bind/imports.kdl",
    "--source",
    "shared=lib",
    "map/entry.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"import\",\"data\":{\"node\":{\"source\":0,\"index\":0},\"expression\":\"$shared/part.kdl\",\"targets\":[\"$shared/part.kdl\"],\"namespace\":null,\"project\":[],\"repeated\":\"coalesce\"",
      "{\"item\":\"document\",\"data\":{\"source\":1,\"path\":\"$shared/part.kdl\"}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":1,\"index\":0},\"type_name\":\"Part\",\"fields\":[{\"name\":\"id\",\"value\":{\"kind\":\"string\",\"value\":\"shared\"},\"origin\":0}],\"origin\":0,\"validation\":\"valid\"}}\n",
      "{\"item\":\"import\",\"data\":{\"node\":{\"source\":0,\"index\":1},\"expression\":\"$shared/./part.kdl\",\"targets\":[\"$shared/part.kdl\"],\"namespace\":null,\"project\":[],\"repeated\":\"coalesce\""
    ],
    "stdout-not-contains": [
      "\"item\":\"diagnostic\"",
      "\"source\":2,\"path\":\"$shared/part.kdl\""
    ]
  }
}
