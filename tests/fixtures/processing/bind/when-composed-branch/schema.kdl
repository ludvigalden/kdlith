schema ui version="1" {
    types {
        enum Variant {
            member plain
            member icon
            member split
        }
        enum Layout {
            member grid
            member list
            member masonry
        }
        object Menu { field label String }
        object Button {
            field label String
            field variant Variant
            field layout "optional<Layout>"
            field dense "optional<Bool>"
            field menus "list<Menu>"
        }
    }
    node button role=record type=Button {
        field label arg=0
        field variant property=variant
        field layout property=layout
        field dense property=dense
        field menus { from { children menu } }
        children menu max-occurs=0 {
            when-all min-occurs=1 max-occurs=1 {
                when property=variant equals=split
                when-any {
                    when property=layout equals=grid
                    when property=layout equals=masonry
                    when-all {
                        when property=layout equals=list
                        when property=dense equals=#true
                    }
                }
            }
            when property=variant equals=plain max-occurs=0
        }
    }
    node menu type=Menu parent=button {
        field label arg=0
    }
}
