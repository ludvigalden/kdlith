{
  "binary": "kdlith",
  "description": "One root=#true declaration admits stack at the document root and nested in itself in the same reading: three levels of stack bind as three Stack records, the innermost first, each holding its own card",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/schemas/vet/recursive-root/schema.kdl",
    "input.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":4},\"type_name\":\"Stack\"",
      "{\"key\":\"title\",\"value\":{\"kind\":\"string\",\"value\":\"bottom\"}}",
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":2},\"type_name\":\"Stack\"",
      "{\"key\":\"title\",\"value\":{\"kind\":\"string\",\"value\":\"middle\"}}",
      "{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":0},\"type_name\":\"Stack\"",
      "{\"key\":\"title\",\"value\":{\"kind\":\"string\",\"value\":\"top\"}}"
    ]
  }
}
