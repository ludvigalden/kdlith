// Imports four enums: a 95-column `use` row, then a 100-column one.
schema widths version="1" {
    types {
        object Tail {
            field id String
            field f0 "optional<TailAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>"
            field f1 "optional<TailBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>"
            field f2 "optional<TailCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>"
            field f3 "optional<TailDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>"
        }
    }
    node tail role=record type=Tail {
        field id arg=0
    }
}
