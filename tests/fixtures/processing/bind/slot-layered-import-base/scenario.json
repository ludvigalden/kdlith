{
  "binary": "kdlith",
  "description": "A projected value keeps its layer across the import boundary: the caller sets the override layer to en and projects lay, and the imported document's later base set (de) is ignored — its stamp reads en — as is the caller's own reading after the import",
  "args": [
    "vet",
    "data",
    "--schema",
    "{fx-suite}/processing/bind/policies.kdl",
    "data.kdl"
  ],
  "expect": {
    "exit": 0,
    "stdout-contains": [
      "{\"item\":\"import\",\"data\":{\"node\":{\"source\":0,\"index\":1},\"expression\":\"part.kdl\",\"targets\":[\"part.kdl\"],\"namespace\":null,\"project\":[\"lay\"],\"repeated\":\"reject\",\"site\":{\"source\":0,\"span\":{\"start\":{\"offset\":12,\"line\":2,\"column\":1},\"end\":{\"offset\":15,\"line\":2,\"column\":4}}},\"origin\":1}}\n{\"item\":\"document\",\"data\":{\"source\":1,\"path\":\"part.kdl\"}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":1,\"index\":1},\"type_name\":\"Stamp\",\"fields\":[{\"name\":\"lay\",\"value\":{\"kind\":\"string\",\"value\":\"en\"},\"origin\":1}],\"origin\":1,\"validation\":\"valid\"}}\n{\"item\":\"scope-complete\",\"data\":{\"source\":1,\"scope\":null}}\n{\"item\":\"record\",\"data\":{\"node\":{\"source\":0,\"index\":3},\"type_name\":\"Stamp\",\"fields\":[{\"name\":\"lay\",\"value\":{\"kind\":\"string\",\"value\":\"en\"},\"origin\":3}],\"origin\":3,\"validation\":\"valid\"}}\n"
    ]
  }
}
