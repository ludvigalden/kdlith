change binding-tables-once {
    summary "Build binding tables and patterns once per definition"
    category performance
    impact public
    touches "pkg/rs/engine"
    commit "aef66c93ff4caa5fe02ebdfd6edce1c3039720e3"
    detail "Each document's binder rebuilt the definition's binding tables and recompiled every declared pattern, which dominated a reading of many small documents. A compiled definition now holds both as derived state, built on first use and shared by every document it binds, on any thread."
}
