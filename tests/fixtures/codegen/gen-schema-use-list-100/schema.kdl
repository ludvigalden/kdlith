// Enums named so that each imported document's sibling import
// lands at 100 columns: one-line, as one wrapped row, and as the
// last of two wrapped rows.
schema widths version="1" {
    import "line.kdl"
    import "row.kdl"
    import "tail.kdl"
    types {
        enum LineAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx {
            member one
        }
        enum LineBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx {
            member one
        }
        enum RowAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx {
            member one
        }
        enum RowBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx {
            member one
        }
        enum TailAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx {
            member one
        }
        enum TailBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx {
            member one
        }
        enum TailCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx {
            member one
        }
        enum TailDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx {
            member one
        }
    }
}
